# Application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (set the public flag only when the provider credentials exist)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (PostgreSQL or Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/ujenzi_dhabiti

# Google Maps Places
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email
RESEND_API_KEY=
RESEND_FROM=Ujenzi Dhabiti <noreply@ujenzidhabiti.co.ke>

# Safaricom Daraja / M-Pesa
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_SECRET=replace-with-a-random-callback-secret
DARAJA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa/callback/replace-with-a-random-callback-secret

# Flutterwave
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
